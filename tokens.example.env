# ==============================================================
# NRP CORPORATE OSINT V4 - CREDENCIALES / CONFIGURACION LOCAL
# Copia este archivo como tokens.env. NO subas tokens.env a Git.
# ==============================================================

# Rutas opcionales. Si son relativas, se resuelven desde la carpeta del proyecto
# en macOS y Windows. También se aceptan rutas absolutas del sistema.
DB_PATH=corporate_osint.sqlite
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/exports

# Puerto y host del dashboard local
NRP_HOST=127.0.0.1
NRP_PORT=8501

# INEGI DENUE - token de API obtenido en INEGI
INEGI_DENUE_TOKEN=

# SearXNG local opcional. Ej.: http://localhost:8080
SEARXNG_URL=

# Clearbit Autocomplete no requiere token actualmente.
ENABLE_CLEARBIT_AUTOCOMPLETE=true

# Fuentes gratuitas sin token
ENABLE_WIKIDATA=true
ENABLE_COMMON_CRAWL=true
ENABLE_DDGS=true
ENABLE_DNS=true

# Seguridad / red
GLOBAL_CONCURRENCY=12
PER_HOST_CONCURRENCY=2
DDGS_MIN_INTERVAL_SECONDS=2.5
WEB_MIN_INTERVAL_SECONDS=0.8
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=300

# Motor
SEARCH_PROVIDER=auto
GENERATE_WEAK_EMAIL_CANDIDATES=true
COMPANY_FUZZY_THRESHOLD=93
COMPANY_DOMAIN_ACCEPT=0.82
PATTERN_ACCEPT=0.72

# Copia local de DENUE (Fuentes > DENUE local o: cli.py denue-update)
DENUE_LOCAL_PATH=data/denue/denue.sqlite
# true = el motor solo usa la copia local de DENUE, sin Internet
DENUE_LOCAL_ONLY=false
